{
  "backend": "gpt2",
  "model_repo": "datificate/gpt2-small-spanish",
  "model_revision": "main",
  "dataset_repo": "SetFit/amazon_reviews_multi_es",
  "dataset_revision": "main",
  "model_dir": "models/base",
  "raw_dir": "data/raw",
  "processed_dir": "data/processed",
  "tokenized_dir": "data/tokenized",
  "checkpoints_dir": "models/checkpoints",
  "results_dir": "results/real",
  "device": "cpu",
  "seed": 42,
  "max_length": 128,
  "batch_size": 1,
  "gradient_accumulation_steps": 4,
  "max_steps": 20,
  "grad_clip": 1.0,
  "max_validation_batches": 4,
  "eval_limit": 0,
  "samples_per_class": {"train": 250,"validation": 50,"test": 100},
  "full_learning_rate": 0.00001,
  "lora_learning_rate": 0.0001,
  "weight_decay": 0.01,
  "lora_rank": 4,
  "lora_alpha": 8,
  "lora_dropout": 0.0,
  "target_modules": ["c_attn"]
}
